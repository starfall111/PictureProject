<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.notification.infrastructure.persistence.SystemMessageMapper">

    <resultMap id="BaseResultMap" type="org.example.notification.domain.model.SystemMessage">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="sendMode" column="sendMode"/>
        <result property="targetType" column="targetType"/>
        <result property="filterRole" column="filterRole"/>
        <result property="filterSpaceLevel" column="filterSpaceLevel"/>
        <result property="filterRegisterStart" column="filterRegisterStart"/>
        <result property="filterRegisterEnd" column="filterRegisterEnd"/>
        <result property="status" column="status"/>
        <result property="publisherId" column="publisherId"/>
        <result property="publishTime" column="publishTime"/>
        <result property="createTime" column="createTime"/>
        <result property="updateTime" column="updateTime"/>
        <result property="isDelete" column="isDelete"/>
    </resultMap>

</mapper>
