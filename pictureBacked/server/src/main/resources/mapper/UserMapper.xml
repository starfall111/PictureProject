<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.server.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="org.example.pojo.entity.User">
            <id property="id" column="id" />
            <result property="userAccount" column="userAccount" />
            <result property="userPhone" column="userPhone" />
            <result property="userEmail" column="userEmail" />
            <result property="userPassword" column="userPassword" />
            <result property="userName" column="userName" />
            <result property="userAvatar" column="userAvatar" />
            <result property="userProfile" column="userProfile" />
            <result property="userRole" column="userRole" />
            <result property="editTime" column="editTime" />
            <result property="createTime" column="createTime" />
            <result property="updateTime" column="updateTime" />
            <result property="isDelete" column="isDelete" />
    </resultMap>

    <sql id="Base_Column_List">
        id,userAccount,userPhone,userEmail,userPassword,userName,
        userAvatar,userProfile,userRole,editTime,createTime,
        updateTime,isDelete
    </sql>

    <!-- 按条件筛选用户ID（系统消息定向发送） -->
    <select id="selectIdsByFilter" resultType="java.lang.Long">
        SELECT u.id
        FROM user u
        WHERE u.isDelete = 0
        <if test="filterRole != null and filterRole != ''">
            AND u.userRole = #{filterRole}
        </if>
        <if test="filterSpaceLevel != null">
            AND EXISTS (
                SELECT 1 FROM space s
                WHERE s.userId = u.id
                  AND s.spaceLevel = #{filterSpaceLevel}
                  AND s.isDelete = 0
            )
        </if>
        <if test="filterRegisterStart != null">
            AND u.createTime &gt;= #{filterRegisterStart}
        </if>
        <if test="filterRegisterEnd != null">
            AND u.createTime &lt;= #{filterRegisterEnd}
        </if>
    </select>
</mapper>
